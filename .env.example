# Copy this file to .env and adjust as needed.
# The server loads .env automatically at startup — no need to export variables.

# Path to the YAML config file
SNOWSTORM_MCP_CONFIG=example-configs/config.local.yaml

# Integration test config (uncomment one):
# SNOWSTORM_MCP_TEST_CONFIG=example-configs/config.docker-snowstorm.yaml
# SNOWSTORM_MCP_TEST_CONFIG=example-configs/config.docker-lite.yaml

# Path to SNOMED RF2 archives directory (used by import script)
# SNOMED_RF2_DIR=~/SNOMED-Terminologies

# Streamable HTTP bind address (the container image sets 0.0.0.0)
# FASTMCP_HOST=127.0.0.1
# FASTMCP_PORT=8000

# Comma-separated CORS allow list for the Streamable HTTP endpoint
# (defaults to https://claude.ai,https://claude.com)
# SNOWSTORM_MCP_CORS_ALLOW_ORIGINS=https://claude.ai,https://claude.com

# Hostnames this server is reached on. Setting this enables DNS rebinding
# protection (invalid Origin -> 403, unknown Host -> 421). Leave unset unless
# you can list every hostname, or all requests will be rejected.
# SNOWSTORM_MCP_ALLOWED_HOSTS=mcp.example.org,mcp.example.org:443

# Uncomment to set auth tokens for specific targets:
# SNOWSTORM_LITE_TOKEN=my-secret-token
# SNOWSTORM_MCP_TARGETS__LITE_US__AUTH__TOKEN=my-secret-token
